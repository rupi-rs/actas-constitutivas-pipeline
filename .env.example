# Copy to .env and never commit it; an empty OPENAI_API_KEY selects the offline SHA-256 cache.
OPENAI_API_KEY=

# Model for structured extraction through the Responses API (OPENAI_MODEL is accepted as a legacy alias).
OPENAI_EXTRACTION_MODEL=gpt-6-luna
# Optional extraction temperature; leave empty for gpt-6-luna, which accepts only its default.
OPENAI_EXTRACTION_TEMPERATURE=
# Model for the Tier 2 Decisions API verifier; gpt-6-luna is the only supported model.
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Vision model that re-reads low-confidence OCR regions (cropped image) before extraction.
OPENAI_VISION_MODEL=gpt-6-luna
# Optional OpenAI-compatible base URL for extraction and VLM re-read; Decisions (/v1/decisions) is OpenAI Cloud only today.
OPENAI_BASE_URL=
# Normalized Decisions OCR_LEGIBILITY_SCORE below which critical fields of a scanned page are escalated.
PAGE_LEGIBILITY_THRESHOLD=0.75
# Normalized Decisions PROMPT_INJECTION_RISK_SCORE at or above which a page is flagged for review.
PROMPT_INJECTION_RISK_THRESHOLD=0.5
LOG_LEVEL=INFO

# Optional: set ACTAS_PROJECT_ROOT=/app and ACTAS_AUDIT_LOG_PATH to relocate outputs.
