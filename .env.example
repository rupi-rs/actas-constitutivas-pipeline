# Copy this file to .env and adjust the values. Never commit a populated .env file.

# OpenAI API key for live LLM extraction and verification.
# Leave empty to run with the deterministic pre-verified SHA-256 cache
# (data/cache/{sha256}.json). No network calls are made in that mode.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-2024-08-06
LOG_LEVEL=INFO

# Optional overrides. By default data/, outputs/ and logs/ live under the project root.
# ACTAS_PROJECT_ROOT=/app
# ACTAS_AUDIT_LOG_PATH=/app/logs/pipeline_audit.jsonl
